// Cloudflare Workers · plan gratuito. Despliegue: npm run cf:deploy
{
  "name": "sesubasta-remates",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "SeSubastaApp" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SeSubastaApp"] }],
  "vars": { "SCRYPT_N": "4096" },
  "observability": { "enabled": true }
}
