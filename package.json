{
  "name": "sesubasta-prototipo-dinamico",
  "version": "4.1.0",
  "private": true,
  "scripts": {
    "start": "node server.cjs",
    "dev": "SESUBASTA_DEV=1 node server.cjs",
    "build": "node build.cjs",
    "test": "node --test pruebas.cjs pruebas-servidor.cjs",
    "reiniciar-datos": "node -e \"require('fs').rmSync('runtime-data',{recursive:true,force:true});console.log('Datos de prueba eliminados. Se crearán de nuevo al iniciar.')\"",
    "cf:preparar": "node scripts/preparar-cloudflare.cjs",
    "cf:dev": "node scripts/preparar-cloudflare.cjs && wrangler dev",
    "cf:deploy": "node scripts/preparar-cloudflare.cjs && wrangler deploy",
    "cf:clave": "wrangler secret put SITE_PASSWORD"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  }
}
